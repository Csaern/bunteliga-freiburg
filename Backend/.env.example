# ==========================================
# Bunte Liga Freiburg - Backend Environment
# ==========================================

# Port (in Plesk oft automatisch über Umgebungsvariable geregelt)
PORT=3001

# URLs (in Plesk Produktion ist Frontend & Backend dieselbe Domain)
WEBSITE_URL=https://bunteliga-freiburg.de
API_URL=https://bunteliga-freiburg.de

# CORS: Für interne / geschützte Routen (Dashboard, Admin, etc.)
CORS_ORIGIN=https://bunteliga-freiburg.de

# Öffentliche Team-API (/api/public) für externe Vereins-Websites
# Cache-Dauer in Sekunden (Standard: 60)
PUBLIC_API_CACHE_SECONDS=60

# Rate-Limit pro Minute und IP (Standard: 120)
PUBLIC_API_RATE_LIMIT=120

# Basis-URL für absolute Logo-Pfade in der öffentlichen API (optional, sonst wird API_URL verwendet)
PUBLIC_BASE_URL=https://bunteliga-freiburg.de
